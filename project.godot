; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dead Route"
config/description="Top-down zombie survival delivery roguelite."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true
general/default_playback_type.web=0

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Assets="*res://scripts/autoload/assets.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
WalletSession="*res://scripts/autoload/wallet_session.gd"
Net="*res://scripts/autoload/net.gd"
MatchState="*res://scripts/autoload/match_state.gd"
Voice="*res://scripts/audio/voice_chat.gd"
Fx="*res://scripts/autoload/fx.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[dead_route]

wallet/bridge_url=""
wallet/bridge_url.web="https://auth.deathroute.fun"
network/room_service=""

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/mode.web="viewport"
window/dpi/allow_hidpi.web=false
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/ui/game_theme.tres"

