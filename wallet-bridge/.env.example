WALLET_PUBLIC_URL=http://127.0.0.1:8787
WALLET_BIND=127.0.0.1
WALLET_PORT=8787
# Allowed Web game origins, comma-separated (no trailing slash).
GAME_ORIGIN=https://deathroute.fun,https://dead-route.pages.dev

# Google Cloud OAuth web application credentials (direct Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dedicated funded testnet account for background player account provisioning.
# Without these settings, Google sign-in still works and item access stays locked.
NEAR_RELAYER_ACCOUNT=
NEAR_RELAYER_KEY=
# 32 random bytes encoded as hex. Keep this stable and backed up privately.
NEAR_ACCOUNT_ROOT_KEY=
# Initial storage balance in yoctoNEAR (0.01 testnet NEAR).
NEAR_INITIAL_BALANCE=10000000000000000000000

# The actual minted token and its NEP-171 contract. Both identifiers are public.
NEAR_NFT_NETWORK=testnet
NEAR_SHOTGUN_CONTRACT=
NEAR_SHOTGUN_TOKEN_ID=
