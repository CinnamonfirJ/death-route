WALLET_PUBLIC_URL=http://127.0.0.1:8787
WALLET_BIND=127.0.0.1
WALLET_PORT=8787
# Optional origin of the exported Web game (no trailing slash).
GAME_ORIGIN=

# Google Cloud OAuth web application credentials (direct Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional legacy Auth0 provider for NEAR Auth-compatible testnet provisioning.
# Used only when both GOOGLE_CLIENT values are blank.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave blank for a public PKCE client registered with token_endpoint_auth_method=none.
OIDC_CLIENT_SECRET=

# Optional dedicated funded testnet account for Google wallet provisioning.
# Leave both blank to use Google sign-in and connect an existing wallet separately.
NEAR_RELAYER_ACCOUNT=
NEAR_RELAYER_KEY=
# Initial storage balance in yoctoNEAR (0.01 testnet NEAR).
NEAR_INITIAL_BALANCE=10000000000000000000000

# The actual minted token and its NEP-171 contract. Both identifiers are public.
NEAR_NFT_NETWORK=testnet
NEAR_SHOTGUN_CONTRACT=
NEAR_SHOTGUN_TOKEN_ID=
