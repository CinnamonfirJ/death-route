extends Node
## Sound effects. Sounds are generated by tools/gen_sfx.py into res://assets/audio/.
##   Sfx.play(&"pistol", global_position)   positional (fades with distance)
##   Sfx.play(&"pickup")                    non-positional (UI / your own events)
##   Sfx.loop_player(&"engine", parent)     a looping 2D player you control (car engines)
## Sound effects and the score have independent volume settings.

const DIR := "res://assets/audio/"
const MUSIC_PATH := "res://assets/audio/night_route.wav"
const SFX_BUS := &"SFX"
const MUSIC_BUS := &"Music"
## Logical name -> variants (one is picked at random).
const SOUNDS := {
	&"pistol": ["pistol"], &"shotgun": ["shotgun"], &"reload": ["reload"], &"jam": ["jam"],
	&"hit_flesh": ["hit_flesh"], &"zombie_die": ["zombie_die"],
	&"groan": ["groan_1", "groan_2", "groan_3"],
	&"explosion": ["explosion"], &"crash": ["crash"], &"ram": ["ram"], &"pickup": ["pickup"],
	&"task_work": ["task_work"], &"task_done": ["task_done"], &"cough": ["cough"],
	&"player_hurt": ["player_hurt"], &"alert": ["alert"], &"ui_click": ["ui_click"], &"engine": ["engine"],
	&"knife_swing": ["knife_swing"], &"knife_hit": ["knife_hit"],
	&"zombie_step": ["zombie_step_1", "zombie_step_2"], &"zombie_attack": ["zombie_attack_1", "zombie_attack_2"],
	&"horn": ["horn"],
	&"generator_hum": ["generator_hum"], &"acid_tick": ["acid_tick"],
	&"zombie_skitter": ["zombie_skitter"], &"zombie_guard": ["zombie_guard"],
}
## Per-sound loudness trims (dB).
const TRIM := {&"zombie_step": -10.0, &"knife_swing": -6.0, &"groan": -6.0, &"task_work": -4.0, &"ui_click": -6.0, &"alert": -2.0, &"hit_flesh": -3.0}
const POOL_2D := 24
const POOL_UI := 6
## Same sound again within this many ms is skipped (shotgun pellets, crowds).
const THROTTLE_MS := 35

@export var music_level_db := -15.0
## Minimum time between idle calls, shared by the horde on this client.
@export var zombie_voice_spacing := 1.25

var _streams := {}
var _last_played := {}
var _pool_2d: Array[AudioStreamPlayer2D] = []
var _pool_ui: Array[AudioStreamPlayer] = []
var _next_2d := 0
var _next_ui := 0
var _next_zombie_voice_ms := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus(SFX_BUS)
	_ensure_bus(MUSIC_BUS)
	for key in SOUNDS:
		var list: Array[AudioStream] = []
		for file in SOUNDS[key]:
			var path: String = DIR + file + ".wav"
			if ResourceLoader.exists(path):
				list.append(load(path))
		_streams[key] = list
	for loop in [&"engine", &"generator_hum"]:
		if not _streams[loop].is_empty():
			var stream: AudioStreamWAV = _streams[loop][0]
			stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
			stream.loop_begin = 0
			stream.loop_end = int(stream.get_length() * stream.mix_rate)
	for i in POOL_2D:
		var p := AudioStreamPlayer2D.new()
		p.bus = SFX_BUS
		p.max_distance = 900.0
		p.attenuation = 1.6
		add_child(p)
		_pool_2d.append(p)
	for i in POOL_UI:
		var p := AudioStreamPlayer.new()
		p.bus = SFX_BUS
		add_child(p)
		_pool_ui.append(p)
	GameManager.settings_changed.connect(_apply_volume)
	_apply_volume()
	if DisplayServer.get_name() != "headless":
		_start_music()
	EventBus.noise_threshold_reached.connect(func(t: int) -> void:
		if t >= 2:
			play(&"alert"))


func _ensure_bus(bus: StringName) -> void:
	if AudioServer.get_bus_index(bus) != -1:
		return
	AudioServer.add_bus()
	var idx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus)
	AudioServer.set_bus_send(idx, &"Master")


func _apply_volume() -> void:
	_set_bus_volume(SFX_BUS, float(GameManager.get_setting("sfx_volume")))
	_set_bus_volume(MUSIC_BUS, float(GameManager.get_setting("music_volume")))


func _set_bus_volume(bus: StringName, volume: float) -> void:
	var idx := AudioServer.get_bus_index(bus)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(volume, 0.0001)))
	AudioServer.set_bus_mute(idx, volume <= 0.001)


func _start_music() -> void:
	var stream := load(MUSIC_PATH) as AudioStreamWAV
	if stream == null:
		return
	var score := AudioStreamPlayer.new()
	score.name = "Score"
	score.bus = MUSIC_BUS
	score.volume_db = music_level_db
	score.stream = stream
	add_child(score)
	score.play()


func play_zombie_ambience(sound: StringName, pos: Vector2, volume_db: float) -> void:
	var now := Time.get_ticks_msec()
	if now < _next_zombie_voice_ms or sound.is_empty():
		return
	_next_zombie_voice_ms = now + int(zombie_voice_spacing * 1000.0)
	play(sound, pos, volume_db, 0.15)


## Plays a sound. With a position it's 2D (attenuated); without, it's flat.
func play(sound: StringName, pos: Variant = null, volume_db := 0.0, pitch_jitter := 0.08) -> void:
	var list: Array = _streams.get(sound, [])
	if list.is_empty():
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(sound, -1000)) < THROTTLE_MS:
		return
	_last_played[sound] = now
	var stream: AudioStream = list.pick_random()
	var pitch := 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	var db: float = volume_db + TRIM.get(sound, 0.0)
	if pos is Vector2:
		var p := _pool_2d[_next_2d]
		_next_2d = (_next_2d + 1) % _pool_2d.size()
		p.stream = stream
		p.global_position = pos
		p.volume_db = db
		p.pitch_scale = pitch
		p.play()
	else:
		var u := _pool_ui[_next_ui]
		_next_ui = (_next_ui + 1) % _pool_ui.size()
		u.stream = stream
		u.volume_db = db
		u.pitch_scale = pitch
		u.play()


## A dedicated looping 2D player parented to `parent` (stopped; caller controls it).
func loop_player(sound: StringName, parent: Node) -> AudioStreamPlayer2D:
	var list: Array = _streams.get(sound, [])
	var p := AudioStreamPlayer2D.new()
	p.bus = SFX_BUS
	p.max_distance = 700.0
	p.attenuation = 1.8
	if not list.is_empty():
		p.stream = list[0]
	parent.add_child(p)
	return p
