[gd_scene load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/locations/map_location.gd" id="1_level"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/car/car.tscn" id="3_car"]
[ext_resource type="Script" path="res://scripts/camera/game_camera.gd" id="4_camera"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="5_hud"]
[ext_resource type="Script" path="res://scripts/systems/noise_director.gd" id="6_noise"]
[ext_resource type="Script" path="res://scripts/systems/car_spawner.gd" id="7_carspawn"]
[ext_resource type="PackedScene" path="res://scenes/locations/extraction_zone.tscn" id="8_ext"]
[ext_resource type="PackedScene" path="res://scenes/ui/run_summary.tscn" id="9_summary"]

[node name="Hospital" type="Node2D"]
script = ExtResource("1_level")
location_id = &"hospital"
location_name = "St. Mercy Hospital"
map_file = "res://levels/hospital.txt"
legend_id = "hospital"

[node name="Ground" type="TileMapLayer" parent="."]
modulate = Color(0.78, 0.72, 0.68, 1)
z_index = -10

[node name="Roads" type="TileMapLayer" parent="."]
z_index = -9

[node name="Floors" type="TileMapLayer" parent="."]
z_index = -8

[node name="Decals" type="Node2D" parent="." groups=["decals"]]
z_index = -5

[node name="NavigationRegion2D" type="NavigationRegion2D" parent="."]

[node name="SpawnPoints" type="Node2D" parent="."]

[node name="Bounds" type="StaticBody2D" parent="."]
collision_mask = 0

[node name="Entities" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Walls" type="TileMapLayer" parent="Entities"]

[node name="Player" parent="Entities" instance=ExtResource("2_player")]

[node name="Car" parent="Entities" instance=ExtResource("3_car")]
vehicle_id = &"delivery_hatch"

[node name="NoiseDirector" type="Node" parent="." node_paths=PackedStringArray("spawn_parent")]
script = ExtResource("6_noise")
spawn_parent = NodePath("../Entities")

[node name="CarSpawner" type="Node" parent="." node_paths=PackedStringArray("spawn_parent", "starting_car")]
script = ExtResource("7_carspawn")
spawn_parent = NodePath("../Entities")
starting_car = NodePath("../Entities/Car")

[node name="ExtractionZone" parent="." instance=ExtResource("8_ext")]

[node name="RunSummary" parent="." instance=ExtResource("9_summary")]

[node name="GameCamera" type="Camera2D" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("4_camera")
target = NodePath("../Entities/Player")

[node name="HUD" parent="." instance=ExtResource("5_hud")]